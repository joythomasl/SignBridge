{
  "manifest_version": 3,
  "name": "SignBridge AI",
  "version": "0.7.1",
  "description": "A Gemma 4-powered, candidate-controlled sign and speech bridge for Google Meet interviews.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tts"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "sandbox": { "pages": ["vision.html"] },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/mediapipe/*",
        "vendor/tflite/*",
        "models/*",
        "vision.html",
        "vision-frame.js",
        "assets/asl/*",
        "hud.css"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "action": {
    "default_title": "SignBridge AI"
  }
}
