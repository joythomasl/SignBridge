{
  "name": "signbridge-ai",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Gemma 4-powered bidirectional interview accessibility prototype for Google Meet",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fingerspelling-templates": "node scripts/build-fingerspelling-templates.mjs",
    "extract:alphabet-features": "node scripts/extract-alphabet-features.mjs",
    "train:alphabet": "python scripts/train-alphabet-model.py",
    "import:fingerspelling": "node scripts/import-fingerspelling-dataset.mjs",
    "ollama:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ollama.ps1",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:kaggle": "node scripts/probe-kaggle-model.mjs",
    "smoke:ollama": "node scripts/smoke-ollama.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tensorflow/tfjs-backend-cpu": "^4.9.0",
    "@tensorflow/tfjs-core": "^4.9.0",
    "@tensorflow/tfjs-tflite": "^0.0.1-alpha.10"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "esbuild": "^0.25.11",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
